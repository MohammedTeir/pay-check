# ===========================================
# Card Validator Bot - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# cp .env.template .env

# Application Environment
# - development: Uses polling mode (local testing)
# - production: Uses webhook mode (deployment)
APP_ENV=development

# ===========================================
# Required Configuration
# ===========================================

# Telegram Bot (get from @BotFather)
TELEGRAM_BOT_TOKEN=

# Supabase (Project Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Encryption Key (run: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=

# ===========================================
# Optional Configuration
# ===========================================

# Admin Telegram User IDs (comma-separated)
ADMIN_IDS=

# Admin Contact Username
ADMIN_CONTACT=@admin

# Crypto Payment Addresses
CRYPTO_ADDRESS_USDT=
CRYPTO_ADDRESS_BTC=

# Stripe Configuration
STRIPE_PUBLISHABLE_KEY=
STRIPE_AMOUNT_CENTS=50

# Webapp Port (for Stripe Elements)
WEBAPP_PORT=5000

# Rate Limiting
RATE_LIMIT_PER_HOUR=5
RATE_LIMIT_PER_DAY=20
STRIPE_ACCOUNT_DAILY_LIMIT=200

# Card Cooldown (hours)
CARD_COOLDOWN_HOURS=24

# BIN Lookup (optional)
BIN_LOOKUP_API_KEY=
BINSEARCH_API_KEY=
BINSEARCH_USER_ID=

# OpenRouter AI (optional)
OPENROUTER_API_KEY=

# ===========================================
# Webhook Configuration (Required for Production)
# ===========================================
# Only needed when APP_ENV=production
# Or if you want to use webhook in development

# WEBHOOK_URL=https://your-domain.com/webhook
# WEBHOOK_SECRET=
