# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Encryption Key (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your_encryption_key_here

# Admin Telegram User IDs (comma-separated)
ADMIN_IDS=123456789

# Crypto Payment Addresses
CRYPTO_ADDRESS_USDT=your_usdt_address_here
CRYPTO_ADDRESS_BTC=your_btc_address_here

# Admin Contact (Telegram username for users to contact)
ADMIN_CONTACT=@teirmido

# Stripe Default Amount (in cents, $0.50 = 50)
STRIPE_AMOUNT_CENTS=50

# Rate Limiting Configuration
RATE_LIMIT_PER_HOUR=5
RATE_LIMIT_PER_DAY=20
STRIPE_ACCOUNT_DAILY_LIMIT=200

# Card Cooldown (hours before same card can be validated again)
CARD_COOLDOWN_HOURS=24

# BIN Lookup (optional — leave empty to skip)
# binlist.net premium key (optional — free tier needs no key)
BIN_LOOKUP_API_KEY=
# binsearchlookup.com credentials (signup at binsearchlookup.com)
BINSEARCH_API_KEY=
BINSEARCH_USER_ID=

# Webhook Configuration (set to enable webhook mode instead of polling)
# WEBHOOK_URL=https://pay-check.onrender.com/webhook
# WEBHOOK_SECRET=
# Note: Webhook runs on the same port as Flask (WEBAPP_PORT)
